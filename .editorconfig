# 统一编辑器行为：源码与配置一律 UTF-8 + LF + 末尾换行。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,toml,yml,yaml}]
indent_size = 2

[*.md]
# Markdown 行尾两个空格是换行语法，不能裁掉。
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
